screen.ND = End
  option.ND_VD_DN = Void darkness
    option.ND_VD_DN.comment = How dark the void is. 1 is full black and 0 is none
  option.ND_VD_HG = Void Height
    option.ND_VD_HG.comment = Block height at which the void begins
  option.ND_VD_Depth = Void Depth
    option.ND_VD_HG.comment = Distance in blocks to transition into the void
  option.END_VOID = End Void Mode
    option.END_VOID.comment = Off: No void effect. Full: Total darkness. Thin: Gets dark, but lights still work. Border: Full, but not around the main island.
    value.END_VOID.0 = Off
    value.END_VOID.1 = Full
    value.END_VOID.2 = Thin
    value.END_VOID.3 = Border

