screen.EFFECTS = Effects
  option.FX_WT_A = Water Transparency
    option.WT_A.comment = How well you can see through the water.
    value.WT_A.0.00 = Don't Render
    value.WT_A.1.00 = Vanilla
  option.FX_WT_B = Water Shine
    option.WT_B.comment = How much the details on the water texture stand out.
    value.WT_B.2.0 = Blue Lava
    value.WT_B.1.0 = Subtle
    value.WT_B.0.0 = Vanilla
  option.FX_PT_A = Portal Transparency
    option.FX_PT_A.comment = How well you can see through the portal.
    value.FX_PT_A.0.00 = Don't Render
    value.FX_PT_A.1.00 = Vanilla
